---
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
---
<Base title="Page not found">
  <section class="section">
    <div class="container notfound">
      <p class="eyebrow">404</p>
      <h1 class="display">This page couldn't be found.</h1>
      <p class="lead">Ironic, given what we do. Let's get you back on track.</p>
      <Button href="/" arrow>Go to the home page</Button>
    </div>
  </section>
</Base>

<style>
  .notfound { display: grid; gap: var(--space-5); justify-items: start; max-width: 48rem; }
</style>
