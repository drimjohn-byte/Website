---
import Icon from "./Icon.astro";
import type { Service } from "../config/site";
interface Props { service: Service }
const { service } = Astro.props;
---
<article class:list={["card", service.badge && "card--featured"]} data-reveal>
  {service.badge && <p class="card__badge">{service.badge}</p>}
  <span class="card__icon"><Icon name={service.icon} /></span>
  <h3>{service.title}</h3>
  <p class="muted">{service.short}</p>
  <ul role="list" class="card__list">
    {service.includes.slice(0, 4).map((item) => <li><Icon name="check" />{item}</li>)}
  </ul>
  <div class="card__foot">
    <p class="card__price"><span class="muted">From</span> <strong>{service.price}</strong></p>
    <a class="card__link" href={`/services/${service.slug}`}>Details<span class="visually-hidden"> about {service.title}</span> <Icon name="arrow" /></a>
  </div>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: var(--space-3); padding: var(--space-6); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius); transition: box-shadow var(--duration-fast) var(--ease), transform var(--duration-fast) var(--ease); }
  .card:hover { box-shadow: var(--shadow-lg); }
  .card--featured { border: 2px solid var(--sl-signal); box-shadow: var(--shadow); }
  .card__badge { position: absolute; top: var(--space-5); right: var(--space-5); padding: 0.2rem 0.7rem; border-radius: var(--radius-pill); background: var(--sl-signal); color: var(--sl-ink); font-size: var(--text-label); font-weight: 700; }
  .card__icon { display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 14px; background: color-mix(in srgb, var(--sl-signal) 14%, transparent); color: var(--sl-signal-deep); margin-bottom: var(--space-2); }
  .card__icon .icon { width: 1.5rem; height: 1.5rem; }
  .card__list { display: grid; gap: var(--space-2); font-size: var(--text-small); margin-block: var(--space-2) var(--space-4); }
  .card__list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2); align-items: start; }
  .card__list .icon { color: var(--sl-go); margin-top: 0.1rem; width: 1.1rem; height: 1.1rem; }
  .card__foot { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-4); border-top: 1px solid var(--color-line); }
  .card__price strong { font-family: var(--font-display); font-size: 1.5rem; }
  .card__link { display: inline-flex; align-items: center; gap: var(--space-1); font-weight: 600; text-decoration: none; color: var(--color-accent-text); }
  /* Whole card is clickable via the details link */
  .card__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .card__link:focus-visible { outline: none; }
  .card:has(.card__link:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 3px; }
</style>
