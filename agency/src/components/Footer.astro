---
import Logo from "./Logo.astro";
import Contact from "./Contact.astro";
import { site, services, isTodo } from "../config/site";
const year = new Date().getFullYear();
const tel = site.phone.replace(/[^\d+]/g, "");
const socials = Object.entries(site.social).filter(([, url]) => url);
---
<footer class="footer theme-ink">
  <div class="container footer__grid">
    <div class="footer__brand">
      <Logo />
      <p class="muted">{site.tagline} Websites, Google and social setup for small businesses across {site.serviceArea}.</p>
    </div>
    <div>
      <h2 class="footer__h">Services</h2>
      <ul role="list">{services.map((s) => <li><a href={`/services/${s.slug}`}>{s.title}</a></li>)}</ul>
    </div>
    <div>
      <h2 class="footer__h">Contact</h2>
      <ul role="list">
        <li><Contact label="Email" value={site.email} href={`mailto:${site.email}`} /></li>
        <li><Contact label="Phone" value={site.phone} href={`tel:${tel}`} /></li>
        <li><Contact label="City" value={site.address.city} />{!isTodo(site.address.city) && `, ${site.address.region}`}</li>
        {socials.map(([name, url]) => <li><a href={url} rel="me noopener">{name[0].toUpperCase() + name.slice(1)}</a></li>)}
      </ul>
    </div>
  </div>
  <div class="container footer__legal muted">
    <p>&copy; {year} {site.name}. Prices in Canadian dollars, plus HST.</p>
    <a href="/privacy">Privacy</a>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-8) var(--space-6); }
  .footer__grid { display: grid; gap: var(--space-7); grid-template-columns: 2fr 1fr 1fr; padding-bottom: var(--space-7); border-bottom: 1px solid var(--color-line); }
  .footer__brand { display: grid; gap: var(--space-4); align-content: start; }
  .footer__brand p { max-width: 34ch; }
  .footer__h { font-family: var(--font-body); font-size: var(--text-label); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-4); }
  .footer ul { display: grid; gap: var(--space-2); }
  .footer a { text-decoration: none; }
  .footer a:hover { text-decoration: underline; }
  .footer__legal { display: flex; justify-content: space-between; gap: var(--space-4); padding-top: var(--space-5); font-size: var(--text-small); }
  @media (max-width: 720px) { .footer__grid { grid-template-columns: 1fr 1fr; } .footer__brand { grid-column: 1 / -1; } }
</style>
