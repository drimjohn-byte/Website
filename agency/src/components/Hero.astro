---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { site, promises } from "../config/site";
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">For small businesses across {site.serviceArea}</p>
      <h1 class="display">Get your business <span class="hero__hl">found</span> online.</h1>
      <p class="lead">
        We build your website and set up your Google Business Profile, Google Analytics and social media,
        so customers nearby can find you, trust you and call you. Flat prices. Everything in your name.
      </p>
      <div class="hero__ctas">
        <Button href={site.bookingUrl || "/#contact"} arrow>Book a free 15-minute call</Button>
        <Button href="/#pricing" variant="secondary">See prices</Button>
      </div>
      <ul role="list" class="hero__promises">
        {promises.map((p) => <li><Icon name="check" />{p.title}</li>)}
      </ul>
    </div>

    <!-- Illustration of the end result: a local search, a business profile and an analytics card -->
    <div class="hero__art" aria-hidden="true">
      <div class="art-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/></svg>
        <span>plumber near me</span>
      </div>
      <div class="art-profile">
        <div class="art-map">
          <span class="art-map__road art-map__road--a"></span>
          <span class="art-map__road art-map__road--b"></span>
          <span class="art-map__pin"><Icon name="pin" /></span>
        </div>
        <div class="art-profile__body">
          <p class="art-profile__name">Your Business</p>
          <p class="art-profile__stars"><span>★★★★★</span> Plumber · Open now</p>
          <div class="art-profile__actions">
            <span><Icon name="phone" />Call</span>
            <span><Icon name="pin" />Directions</span>
            <span><Icon name="website" />Website</span>
          </div>
        </div>
      </div>
      <div class="art-stats">
        <p>Calls from Google</p>
        <div class="art-bars"><span style="--h:30%"></span><span style="--h:42%"></span><span style="--h:38%"></span><span style="--h:58%"></span><span style="--h:66%"></span><span style="--h:82%"></span><span style="--h:100%"></span></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(var(--space-7), 2rem + 5vw, var(--space-9)) var(--section-y); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.1fr 1fr; gap: var(--space-8); align-items: center; }
  .hero__copy { display: grid; gap: var(--space-5); justify-items: start; }
  .hero__hl { position: relative; white-space: nowrap; }
  .hero__hl::after { content: ""; position: absolute; left: -0.04em; right: -0.04em; bottom: 0.04em; height: 0.22em; background: var(--sl-signal); border-radius: 0.1em; z-index: -1; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-2); }
  .hero__promises { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--text-small); font-weight: 500; }
  .hero__promises li { display: inline-flex; align-items: center; gap: var(--space-1); }
  .hero__promises .icon { color: var(--sl-go); }

  .hero__art { position: relative; display: grid; gap: var(--space-4); padding: var(--space-6); background: var(--sl-sky); border-radius: var(--radius-lg); }
  .hero__art > * { background: var(--color-surface); border-radius: var(--radius); box-shadow: var(--shadow); }
  .art-search { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-3) var(--space-5); border-radius: var(--radius-pill); font-size: 0.9375rem; }
  .art-search svg { width: 1.125rem; color: var(--sl-ink-soft); }
  .art-profile { overflow: hidden; box-shadow: var(--shadow-lg); transform: rotate(-1.5deg); }
  .art-map { position: relative; height: 7.5rem; background: #E8EEF3; overflow: hidden; }
  .art-map__road { position: absolute; background: #fff; }
  .art-map__road--a { left: -10%; right: -10%; top: 45%; height: 12px; transform: rotate(-8deg); }
  .art-map__road--b { top: -10%; bottom: -10%; left: 62%; width: 10px; transform: rotate(14deg); }
  .art-map__pin { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -70%); color: var(--sl-signal); }
  .art-map__pin .icon { width: 2.5rem; height: 2.5rem; fill: var(--sl-signal); stroke: #fff; stroke-width: 1.25; }
  .art-profile__body { padding: var(--space-4) var(--space-5) var(--space-5); display: grid; gap: var(--space-1); }
  .art-profile__name { font-family: var(--font-display); font-weight: 700; font-size: 1.375rem; }
  .art-profile__stars { font-size: var(--text-small); color: var(--sl-ink-soft); }
  .art-profile__stars span { color: #E8A317; letter-spacing: 0.05em; }
  .art-profile__actions { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }
  .art-profile__actions span { display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.35rem 0.75rem; border: 1px solid var(--color-line); border-radius: var(--radius-pill); font-size: 0.8125rem; font-weight: 500; color: #1A56B8; }
  .art-profile__actions .icon { width: 1rem; height: 1rem; }
  .art-stats { justify-self: end; width: min(15rem, 80%); padding: var(--space-4) var(--space-5); margin-top: calc(var(--space-6) * -1); position: relative; }
  .art-stats p { font-size: var(--text-small); font-weight: 600; margin-bottom: var(--space-3); }
  .art-bars { display: flex; align-items: end; gap: 6px; height: 3.5rem; }
  .art-bars span { flex: 1; height: var(--h); background: var(--sl-go); border-radius: 3px 3px 0 0; opacity: 0.35; }
  .art-bars span:last-child { opacity: 1; }

  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; gap: var(--space-7); }
    .hero__art { padding: var(--space-5); }
  }
</style>
