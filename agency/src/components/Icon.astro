---
// Line icons, 24px grid, drawn in currentColor.
interface Props { name: "website" | "pin" | "chart" | "social" | "check" | "arrow" | "phone" | "mail" | "plus"; class?: string }
const { name, class: className } = Astro.props;
const paths: Record<Props["name"], string> = {
  website: '<rect x="3" y="4" width="18" height="16" rx="2.5"/><path d="M3 8.5h18"/><circle cx="6" cy="6.25" r=".6" fill="currentColor"/><circle cx="8.25" cy="6.25" r=".6" fill="currentColor"/><path d="M7 13h6M7 16h10"/>',
  pin: '<path d="M12 21s-7-6.4-7-11.5a7 7 0 0 1 14 0C19 14.6 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
  chart: '<path d="M4 20V4M4 20h16"/><path d="m7.5 15 3.5-4 3 2.5L19 7"/>',
  social: '<circle cx="6.5" cy="12" r="2.5"/><circle cx="17.5" cy="6" r="2.5"/><circle cx="17.5" cy="18" r="2.5"/><path d="m8.7 10.8 6.6-3.6M8.7 13.2l6.6 3.6"/>',
  check: '<path d="m5 12.5 4.5 4.5L19 7.5"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  phone: '<path d="M6.6 3.5h2.6l1.4 4-2 1.3a12 12 0 0 0 6.6 6.6l1.3-2 4 1.4v2.6a2 2 0 0 1-2.2 2A16.5 16.5 0 0 1 4.6 5.7a2 2 0 0 1 2-2.2Z"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
};
---
<svg class:list={["icon", className]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />

<style>
  .icon { width: 1.25em; height: 1.25em; flex: none; }
</style>
