---
import Icon from "./Icon.astro";
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details class="faq__item">
      <summary><span>{item.q}</span><Icon name="plus" /></summary>
      <p class="muted">{item.a}</p>
    </details>
  ))}
</div>

<style>
  .faq { border-top: 1px solid var(--color-line); }
  .faq__item { border-bottom: 1px solid var(--color-line); }
  .faq__item summary { display: flex; justify-content: space-between; align-items: center; gap: var(--space-4); padding: var(--space-5) 0; cursor: pointer; list-style: none; font-family: var(--font-display); font-weight: 700; font-size: 1.1875rem; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item summary .icon { color: var(--color-accent-text); transition: transform var(--duration-fast) var(--ease); }
  .faq__item[open] summary .icon { transform: rotate(45deg); }
  .faq__item p { padding-bottom: var(--space-5); }
</style>
