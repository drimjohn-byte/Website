---
import Button from "./Button.astro";
import Icon from "./Icon.astro";
import { bundle, carePlan, services } from "../config/site";
---
<div class="pricing">
  <article class="plan plan--featured theme-ink" data-reveal>
    <p class="plan__badge">Best value</p>
    <h3 class="h2">{bundle.title}</h3>
    <p class="muted">{bundle.summary}</p>
    <p class="plan__price"><strong>{bundle.price}</strong> <s class="muted">{bundle.separately}</s></p>
    <p class="plan__meta">One-time. {bundle.payments}. {bundle.turnaround}.</p>
    <ul role="list" class="plan__list">
      {services.map((s) => <li><Icon name="check" /><span><strong>{s.title}</strong> <span class="muted">({s.price} on its own)</span></span></li>)}
    </ul>
    <Button href="/#contact" arrow>Get the package</Button>
  </article>

  <article class="plan" data-reveal>
    <h3 class="h2">{carePlan.title}</h3>
    <p class="muted">{carePlan.summary}</p>
    <p class="plan__price"><strong>{carePlan.price}</strong> <span class="muted">/ {carePlan.per}</span></p>
    <ul role="list" class="plan__list">
      {carePlan.includes.map((item) => <li><Icon name="check" /><span>{item}</span></li>)}
    </ul>
    <Button href="/#contact" variant="secondary">Ask about the care plan</Button>
  </article>
</div>
<p class="pricing__note muted">All prices in Canadian dollars, plus HST. Domain and hosting are paid directly to the provider, in your name, with no markup.</p>

<style>
  .pricing { display: grid; grid-template-columns: 1.4fr 1fr; gap: var(--grid-gap); align-items: stretch; }
  .plan { display: flex; flex-direction: column; gap: var(--space-4); padding: clamp(var(--space-6), 1rem + 3vw, var(--space-8)); background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-lg); }
  .plan .btn { margin-top: auto; align-self: start; }
  .plan--featured { position: relative; box-shadow: var(--shadow-lg); border: 0; }
  .plan__badge { position: absolute; top: var(--space-5); right: var(--space-5); padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); background: var(--sl-signal); color: var(--sl-ink); font-size: var(--text-label); font-weight: 700; }
  .plan__price { display: flex; align-items: baseline; gap: var(--space-3); }
  .plan__price strong { font-family: var(--font-display); font-size: clamp(2.5rem, 2rem + 2vw, 3.5rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1; }
  .plan__price s { font-size: 1.25rem; }
  .plan__meta { font-size: var(--text-small); font-weight: 500; margin-top: calc(var(--space-2) * -1); }
  .plan__list { display: grid; gap: var(--space-3); margin-bottom: var(--space-4); }
  .plan__list li { display: grid; grid-template-columns: auto 1fr; gap: var(--space-3); align-items: start; }
  .plan__list .icon { color: var(--sl-go); margin-top: 0.15rem; }
  .theme-ink .plan__list .icon { color: #4ADE80; }
  .pricing__note { margin-top: var(--space-5); font-size: var(--text-small); }
  @media (max-width: 860px) { .pricing { grid-template-columns: 1fr; } .plan__badge { position: static; justify-self: start; align-self: start; } }
</style>
