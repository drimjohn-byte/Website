---
import { isTodo } from "../config/site";
interface Props { from: string; note?: string; guarantee?: string }
const { from, note, guarantee } = Astro.props;
const isAmount = /^R\s?\d/.test(from);
---
<div class="price">
  {isTodo(from) ? (
    <p class="price__todo label">Price to confirm</p>
  ) : (
    <p class="price__line">
      {isAmount && <span class="label muted">From</span>}
      <span class="price__value">{from}</span>
      {note && <span class="label price__note">{note}</span>}
    </p>
  )}
  {guarantee && <p class="price__guarantee">{guarantee}</p>}
</div>

<style>
  .price { display: grid; gap: var(--space-2); justify-items: start; }
  .price__line { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .price__value { font-family: var(--font-display); font-size: var(--text-h3); font-variant-numeric: lining-nums; }
  .price__note { padding: 0.2em 0.6em; border: 1px solid currentColor; color: var(--color-text-muted); }
  .price__todo { padding: var(--space-2) var(--space-3); background: var(--ww-warm-sand); color: var(--ww-deep-ink); }
  .price__guarantee { font-weight: var(--weight-medium); }
</style>
