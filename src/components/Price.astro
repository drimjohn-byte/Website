---
import { isTodo } from "../config/site";
interface Props { from: string; note?: string; guarantee?: string; tiers?: { label: string; from: string }[] }
const { from, note, guarantee, tiers } = Astro.props;
const isAmount = /^R\s?\d/.test(from);
---
<div class="price">
  {tiers?.length ? (
    <dl class="price__tiers">
      {tiers.map((t) => (
        <div class="price__tier">
          <dt>{t.label}</dt>
          <dd><span class="label muted">From</span> <span class="price__value">{t.from}</span></dd>
        </div>
      ))}
    </dl>
  ) : isTodo(from) ? (
    <p class="price__todo label">Price to confirm</p>
  ) : (
    <p class="price__line">
      {isAmount && <span class="label muted">From</span>}
      <span class="price__value">{from}</span>
    </p>
  )}
  {note && <p class="price__note">{note}.</p>}
  {guarantee && <p class="price__guarantee">{guarantee}</p>}
</div>

<style>
  .price { display: grid; gap: var(--space-2); justify-items: start; }
  .price__line { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-3); }
  .price__value { font-family: var(--font-display); font-size: var(--text-h3); font-variant-numeric: lining-nums; }
  .price__note { font-size: var(--text-small); color: var(--color-text-muted); }
  .price__tiers { display: grid; gap: var(--space-2); width: 100%; margin: 0; }
  .price__tier { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: var(--space-1) var(--space-4); }
  .price__tier dt { font-size: var(--text-small); }
  .price__tier dd { margin: 0; display: flex; align-items: baseline; gap: var(--space-2); }
  .price__todo { padding: var(--space-2) var(--space-3); background: var(--ww-warm-sand); color: var(--ww-deep-ink); }
  .price__guarantee { font-weight: var(--weight-medium); }
</style>
