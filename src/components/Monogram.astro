---
interface Props { size?: number; title?: string; class?: string }
const { size = 32, title, class: className } = Astro.props;
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  role={title ? "img" : undefined}
  aria-hidden={title ? undefined : "true"}
>
  {title && <title>{title}</title>}
  <path d="M7 11 L16.5 37 L24 16 L31.5 37 L41 11" stroke="currentColor" stroke-width="1.75" stroke-linejoin="miter" />
</svg>
