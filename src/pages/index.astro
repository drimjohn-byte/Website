---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Eyebrow from "../components/Eyebrow.astro";
import ServiceRow from "../components/ServiceRow.astro";
import WorkTile from "../components/WorkTile.astro";
import NextProject from "../components/NextProject.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import ImagePlaceholder from "../components/ImagePlaceholder.astro";
import { site, towns, services, process, isTodo } from "../config/site";

const work = (await getCollection("work")).sort((a, b) => b.data.year - a.data.year);

const address = site.address;
const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: site.description,
  areaServed: towns.map((name) => ({ "@type": "City", name })),
  ...(!isTodo(site.email) && { email: site.email }),
  address: {
    "@type": "PostalAddress",
    ...(!isTodo(address.street) && { streetAddress: address.street }),
    addressLocality: address.town,
    ...(!isTodo(address.postcode) && { postalCode: address.postcode }),
    addressRegion: address.region,
    addressCountry: address.country,
  },
};
---
<Base header="transparent">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(schema)} />

  <Hero
    eyebrow="Velddrif · West Coast"
    lead="Aerial photography, film, reels and launch websites for West Coast developments, listings and holiday rentals."
    image={site.heroImage}
    imageBrief="Aerial photograph of Harbour's Edge"
  >Sell out your West Coast launch <em>faster</em>.</Hero>

  <!-- Positioning -->
  <section class="section intro">
    <div class="container grid">
      <div class="intro__statement" data-reveal>
        <Eyebrow text="What we do" />
        <p class="h1 intro__text">The photographs, the film and the website buyers land on, made by one studio to one standard.</p>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section services" id="services" aria-labelledby="services-title">
    <div class="container">
      <header class="section-head grid">
        <div class="section-head__title">
          <Eyebrow number="01" text="Services" />
          <h2 id="services-title" class="h1">Three things, done <em>properly</em>.</h2>
        </div>
      </header>
      <div class="services__list">
        {services.map((service, i) => <ServiceRow service={service} reverse={i % 2 === 1} tone={i === 1 ? "sand" : "stone"} />)}
      </div>
    </div>
  </section>

  <!-- Work -->
  <section class="section theme-ink" id="work" aria-labelledby="work-title">
    <div class="container">
      <header class="section-head grid">
        <div class="section-head__title">
          <Eyebrow number="02" text="Work" />
          <h2 id="work-title" class="h1">Recent work.</h2>
        </div>
      </header>
      <div class="grid work__grid">
        {work.map((project) => (
          <WorkTile
            title={project.data.title}
            location={project.data.location}
            services={project.data.services.join(", ")}
            image={project.data.heroImage}
            src={project.data.heroSrc}
            size="large"
            href={`/work/${project.id}`}
          />
        ))}
        <NextProject />
      </div>
    </div>
  </section>

  <!-- Approach -->
  <section class="section" id="approach" aria-labelledby="approach-title">
    <div class="container">
      <header class="section-head grid">
        <div class="section-head__title">
          <Eyebrow number="03" text="Approach" />
          <h2 id="approach-title" class="h1">Considered from the first conversation.</h2>
        </div>
        <p class="lead muted section-head__aside">Every project follows the same process, so the work is consistent whether it is a single listing or a full development launch.</p>
      </header>
      <ProcessSteps steps={process} />
    </div>
  </section>

  <!-- Full-bleed image break -->
  <div class="break">
    <ImagePlaceholder ratio="21/9" tone="ink" brief="Atmospheric Atlantic landscape: weathered rock and sea under an overcast sky, no people" />
  </div>

  <!-- Areas -->
  <section class="section theme-sand areas" aria-labelledby="areas-title">
    <div class="container grid">
      <div class="areas__intro">
        <Eyebrow number="04" text="Where we work" />
        <h2 id="areas-title" class="h2">Based in Velddrif.</h2>
        <p>Working along the West Coast, from the Berg River mouth to Yzerfontein.</p>
      </div>
      <ul class="areas__list">
        {towns.map((town) => <li class="display">{town}</li>)}
      </ul>
    </div>
  </section>

  <!-- Contact -->
  <section class="section contact" id="contact" aria-labelledby="contact-title">
    <div class="container grid">
      <div class="contact__intro">
        <Eyebrow number="05" text="Let’s talk" />
        <h2 id="contact-title" class="h1">Make your next move <em>count</em>.</h2>
        <p class="lead muted">Tell us about the development, listing or rental you are working on. Your answers open as a WhatsApp message, so the conversation starts straight away.</p>
        <p class="contact__direct label">
          Prefer to message directly? <a href={`https://wa.me/${site.whatsappNumber}`} target="_blank" rel="noopener">WhatsApp us</a>
        </p>
      </div>
      <div class="contact__form">
        <EnquiryForm />
      </div>
    </div>
  </section>
</Base>

<style>
  .section-head { row-gap: var(--space-5); margin-bottom: clamp(var(--space-8), 6vw, var(--space-10)); align-items: end; }
  .section-head__title { grid-column: 1 / -1; display: grid; gap: var(--space-5); }
  .section-head__aside { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .section-head__title { grid-column: 1 / span 8; }
    .section-head__aside { grid-column: 9 / span 4; }
  }

  .intro__statement { grid-column: 1 / -1; display: grid; gap: var(--space-6); }
  .intro__text { max-width: 24ch; }
  @media (min-width: 1024px) { .intro__statement { grid-column: 1 / span 10; } }

  .services__list { display: grid; gap: clamp(var(--space-8), 8vw, var(--space-11)); }

  .work__grid { row-gap: var(--space-8); }
  .work__grid :global(.tile--large) { align-self: start; }
  @media (min-width: 1024px) { .work__grid :global(.tile--large) { grid-column: 1 / span 7; } }

  .areas { padding-block: var(--space-9); }
  .areas .grid { row-gap: var(--space-7); }
  .areas__intro { grid-column: 1 / -1; display: grid; gap: var(--space-4); align-content: start; }
  .areas__list { grid-column: 1 / -1; list-style: none; padding: 0; }
  .areas__list li { font-size: clamp(2.25rem, 1.5rem + 3.5vw, 4.5rem); border-bottom: 1px solid rgba(26, 31, 28, 0.2); padding-block: var(--space-2); }
  @media (min-width: 1024px) {
    .areas__intro { grid-column: 1 / span 4; position: sticky; top: 7rem; }
    .areas__list { grid-column: 6 / span 7; }
  }

  .contact .grid { row-gap: var(--space-8); }
  .contact__intro { grid-column: 1 / -1; display: grid; gap: var(--space-5); align-content: start; }
  .contact__direct { color: var(--color-text-muted); }
  .contact__direct a { color: var(--color-text); }
  .contact__form { grid-column: 1 / -1; }
  @media (min-width: 1024px) {
    .contact__intro { grid-column: 1 / span 5; position: sticky; top: 7rem; }
    .contact__form { grid-column: 7 / span 6; }
  }
</style>
